# Copy this file to .env and fill in real values. Never commit .env.

PORT=5000

# MongoDB connection string (MongoDB Atlas or local)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<database>

# Long random string used to sign login tokens
JWT_SECRET=change-me-to-a-long-random-string

# Cloudinary account for profile and portfolio photos
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Frontend origins allowed to call the API (comma separated).
# The first one is also used for links in emails (password reset).
CLIENT_URL=http://localhost:5173

# Email (password reset). Leave SMTP_HOST empty in development: reset links
# are then printed in the server console and backend/dev-mail.log instead.
# Gmail: smtp.gmail.com, port 465, your address + a 16-character App Password.
# Brevo: smtp-relay.brevo.com, port 587. Mailtrap works well for testing.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Women Skill <no-reply@example.com>"

# Set to production on the live server (then missing SMTP is an error, not a log line)
NODE_ENV=development

# Local time used for working hours and calendars, in minutes from UTC (India = 330)
TZ_OFFSET_MINUTES=330
